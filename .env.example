PORT=3000

# Where bro-vs-bro-overlay's state.json is stored. Leave unset for local dev
# (falls back to apps/brovsbro/). On Render, set to /var/data once a
# persistent disk is attached (requires a paid plan).
DATA_DIR=

BROVSBRO_PANEL_KEY=
MINECRAFT_CONTROL_PANEL_PASSWORD=
MINECRAFT_AUTH_SECRET=
GEAR_CONTROL_PASSWORD=
GAUNTLET_CONTROL_PASSWORD=
TLOU2_CONTROL_PASSWORD=
GTA5_CONTROL_PASSWORD=
MAFIA1_CONTROL_PASSWORD=
MAFIA2_CONTROL_PASSWORD=
MAFIA3_CONTROL_PASSWORD=
PERFEKTMATCH_CONTROL_PASSWORD=

# Bearer token the local OCR tracker script (apps/tlou2/tracker) uses to post
# chapter updates. Must match tlou2-tracker-config.json on the streaming PC.
TLOU2_TRACKER_KEY=

# Bearer token the local save-file tracker script (apps/gta5/tracker) uses to
# post mission updates. Must match gta5-tracker-config.json on the streaming PC.
GTA5_TRACKER_KEY=

RDR2_CONTROL_PASSWORD=

# Bearer token the local save-file tracker script (apps/rdr2/tracker) uses to
# post mission updates. Must match rdr2-tracker-config.json on the streaming PC.
RDR2_TRACKER_KEY=

# Bearer tokens the shared OCR tracker script (apps/_lib/tracker) uses for
# each Mafia game. Must match that game's tracker config on the streaming PC.
MAFIA1_TRACKER_KEY=
MAFIA2_TRACKER_KEY=
MAFIA3_TRACKER_KEY=

# Optional: only needed if you want the minecraft/gauntlet/tlou2/gta5/mafia/rdr2
# trackers' state to survive restarts. Leave unset to keep today's
# in-memory-only behavior.
DATABASE_URL=

# Subcount overlay (/subcount/). Create an app at https://dev.twitch.tv/console
# with OAuth redirect URL https://<your-host>/subcount/auth/callback, then open
# /subcount/auth/login?key=<SUBCOUNT_CONTROL_PASSWORD> once as the broadcaster.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SUBCOUNT_CONTROL_PASSWORD=
# Without DATABASE_URL the login/goal are lost on restart: set the refresh token
# shown after login here, and the goal here.
SUBCOUNT_REFRESH_TOKEN=
SUBCOUNT_DEFAULT_GOAL=
# Optional: SUBCOUNT_TWITCH_CHANNEL (defaults to the logged-in broadcaster),
# SUBCOUNT_CHAT_COMMAND (!subgoal), SUBCOUNT_POLL_SECONDS (30),
# SUBCOUNT_OFFSET (-1: Twitch counts the broadcaster as a sub), SUBCOUNT_PUBLIC_URL.
