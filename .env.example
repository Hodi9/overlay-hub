PORT=3000

# Where bro-vs-bro-overlay's state.json is stored. Leave unset for local dev
# (falls back to apps/brovsbro/). On Render, set to /var/data once a
# persistent disk is attached (requires a paid plan).
DATA_DIR=

BROVSBRO_PANEL_KEY=
MINECRAFT_CONTROL_PANEL_PASSWORD=
MINECRAFT_AUTH_SECRET=
GEAR_CONTROL_PASSWORD=
GAUNTLET_CONTROL_PASSWORD=
TLOU2_CONTROL_PASSWORD=
GTA5_CONTROL_PASSWORD=
MAFIA1_CONTROL_PASSWORD=
MAFIA2_CONTROL_PASSWORD=
MAFIA3_CONTROL_PASSWORD=
PERFEKTMATCH_CONTROL_PASSWORD=

# Bearer token the local OCR tracker script (apps/tlou2/tracker) uses to post
# chapter updates. Must match tlou2-tracker-config.json on the streaming PC.
TLOU2_TRACKER_KEY=

# Bearer token the local save-file tracker script (apps/gta5/tracker) uses to
# post mission updates. Must match gta5-tracker-config.json on the streaming PC.
GTA5_TRACKER_KEY=

# Bearer tokens the shared OCR tracker script (apps/_lib/tracker) uses for
# each Mafia game. Must match that game's tracker config on the streaming PC.
MAFIA1_TRACKER_KEY=
MAFIA2_TRACKER_KEY=
MAFIA3_TRACKER_KEY=

# Optional: only needed if you want the minecraft/gauntlet/tlou2/gta5/mafia
# trackers' state to survive restarts. Leave unset to keep today's
# in-memory-only behavior.
DATABASE_URL=
